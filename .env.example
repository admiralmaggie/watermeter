# Water Meter Reader Configuration
# Copy this file to .env and adjust values for your setup

# ===== ROTATION SETTINGS =====
# Fine rotation adjustment in degrees (negative = clockwise, positive = counter-clockwise)
# Set to 0 to disable fine rotation
FINE_ROTATION_ANGLE=-4

# ===== DIAL DETECTION SETTINGS =====
# Number of dials to detect on the meter
DIALS_COUNT=3

# Use manual circle coordinates instead of detection (true/false)
# When enabled, skips Hough Circle detection and uses predefined coordinates
USE_MANUAL_CIRCLES=false

# Manual circle coordinates (only used if USE_MANUAL_CIRCLES=true)
# Format: x1,y1,r1;x2,y2,r2;x3,y3,r3
# Example: MANUAL_CIRCLES=500,800,150;900,800,150;1300,800,150
MANUAL_CIRCLES=

# Hough Circle detection parameters (only used if USE_MANUAL_CIRCLES=false)
# Higher HOUGH_PARAM2 = fewer circles (more strict)
HOUGH_PARAM2=45
HOUGH_PARAM1=120
HOUGH_DP=1.2

# Dial radius range (as fraction of image dimension)
RADIUS_MIN_FRAC=0.04
RADIUS_MAX_FRAC=0.12

# ===== NEEDLE DETECTION SETTINGS =====
# Minimum pixels required for needle detection
NEEDLE_MIN_PIXELS=80

# HSV color thresholds for red needle detection
# Red hue range 1 (lower red)
RED_HUE_LOWER1=0
RED_SAT_LOWER1=80
RED_VAL_LOWER1=60
RED_HUE_UPPER1=10

# Red hue range 2 (upper red/magenta)
RED_HUE_LOWER2=170
RED_SAT_LOWER2=80
RED_VAL_LOWER2=60

# ===== HARDWARE CROP SETTINGS =====
# Enable hardware cropping at ISP level (true/false)
CROP_ENABLED=false

# Crop region in sensor coordinates (x, y, width, height)
# Full sensor for Pi Camera v3: 4608x2592
CROP_X=0
CROP_Y=0
CROP_WIDTH=4608
CROP_HEIGHT=2592

# ===== CAMERA SETTINGS =====
# Camera resolution (width, height)
CAMERA_WIDTH=4608
CAMERA_HEIGHT=2592

# Preview/stream resolution
PREVIEW_WIDTH=640
PREVIEW_HEIGHT=480

# Enable detection overlay in camera stream (true/false)
# Shows detected circles and needles on the live stream
STREAM_SHOW_DETECTION=false

# ===== MOTION DETECTION SETTINGS =====
# Enable motion detection in camera stream (true/false)
MOTION_DETECTION_ENABLED=false

# Motion detection zone 1 (x, y, radius in pixels)
# Coordinates are after rotation is applied to the frame
MOTION_ZONE1_X=200
MOTION_ZONE1_Y=400
MOTION_ZONE1_R=100

# Motion detection zone 2 (x, y, radius in pixels)
MOTION_ZONE2_X=600
MOTION_ZONE2_Y=400
MOTION_ZONE2_R=100

# Motion detection sensitivity (0-100, higher = more sensitive)
# Minimum percentage of pixels that must change to trigger motion
MOTION_THRESHOLD=2.0

# Motion detection frame skip (check every N frames for efficiency)
MOTION_FRAME_SKIP=3

# Autofocus settings (for Pi Camera v3)
# Enable autofocus (true/false)
AUTOFOCUS_ENABLED=true

# Autofocus mode: "continuous", "trigger", or "manual"
# - continuous: Constantly adjusts focus (AfMode=2)
# - trigger: Triggers focus before each capture (AfMode=1)
# - manual: Fixed focus at specified lens position (AfMode=0)
AUTOFOCUS_MODE=continuous

# Lens position for manual focus mode (only used when AUTOFOCUS_MODE=manual)
# Range: 0.0 (infinity) to ~10.0 (closest focus)
# Typical values: 0.5-3.0 for normal distances
LENS_POSITION=1.0

# ===== DEBUG SETTINGS =====
# Enable debug visualization and image saving
DEBUG_NEEDLE=true

# Enable headless mode (disable GUI windows)
# Auto-detected if DISPLAY is not set, but can be forced here
# HEADLESS=false

# ===== MONITORING SETTINGS =====
# Interval for uploading water usage telemetry (minutes)
UPLOAD_INTERVAL_MINUTES=15

# ThingsBoard access token
THINGSBOARD_TOKEN=

# Leak detection threshold (continuous motion for N minutes)
LEAK_DETECTION_THRESHOLD_MINUTES=60

# Pushover alert settings
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Usage tracking thresholds
# Max gallons used between captures (e.g. 5 seconds) to be considered valid
MAX_VALID_DELTA=5.0

# Jitter threshold (delta above this is considered small negative noise)
# Rollover logic handles this, so 95.0 means a 5.0 gallon decrease is ignored as noise
JITTER_THRESHOLD=95.0

# Re-sync threshold (number of consistent readings to force a reference update)
RESYNC_THRESHOLD=10
